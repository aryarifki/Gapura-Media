{{< layouts/main.dve}}
{{#block title}}{{ article.seo_title }} — {{ site.name }}{{/block}}
{{#block body}}

<article class="container article">
  <p class="crumb"><a href="/">Beranda</a> · <span>{{ article.desk }}</span></p>
  <span class="chip">{{ article.desk }}</span>
  <h1 class="article-headline">{{ article.headline }}</h1>
  <p class="meta-line">{{ article.date_label }} · Gapura Media · Sumber: {{ article.sources.length }} penerbit</p>

  <figure class="article-cover">
    <img src="{{ article.cover.src }}" alt="{{ article.cover.alt }}">
    {{#if article.cover.credit}}<figcaption>Gambar: {{ article.cover.credit }}</figcaption>{{/if}}
  </figure>

  <p class="article-lead">{{ article.lead }}</p>

  {{#if article.takeaways.length}}
  <aside class="takeaways">
    <h2>Poin Penting</h2>
    <ul>
      {{#each article.takeaways as t~}}
      <li>{{ t }}</li>
      {{~/each}}
    </ul>
  </aside>
  {{/if}}

  {{#each article.sections as s~}}
  <section class="article-section">
    {{#if s.heading}}<h2>{{ s.heading }}</h2>{{/if}}
    {{#each s.paragraphs as p~}}
    <p>{{ p }}</p>
    {{~/each}}
  </section>
  {{~/each}}

  {{#if article.sources.length}}
  <aside class="sources">
    <h2>Sumber Berita</h2>
    <ul>
      {{#each article.sources as s~}}
      <li><a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.name }}</a></li>
      {{~/each}}
    </ul>
  </aside>
  {{/if}}

  <aside class="social-box">
    <h2>Berita ini juga terbit di</h2>
    <div class="about-actions">
      {{#if article.social.instagram}}<a class="btn-dark" href="{{ article.social.instagram }}" target="_blank" rel="noopener">Instagram @gapuramedia</a>{{/if}}
      {{#if article.social.facebook}}<a class="btn-ghost" href="{{ article.social.facebook }}" target="_blank" rel="noopener">Facebook Gapura Media</a>{{/if}}
    </div>
  </aside>
</article>

{{#if others.length}}
<section class="container section-block">
  <div class="section-head">
    <h2>Artikel Lainnya</h2>
    <span class="section-rule" aria-hidden="true"></span>
  </div>
  <div class="grid">
    {{#each others as a~}}
    <article class="card">
      <a class="card-media" href="/artikel/{{ a.slug }}/">
        <img src="{{ a.cover.src }}" alt="{{ a.cover.alt }}" loading="lazy">
      </a>
      <div class="card-body">
        <span class="chip">{{ a.desk }}</span>
        <h3 class="card-title"><a href="/artikel/{{ a.slug }}/">{{ a.headline }}</a></h3>
        <p class="meta-line">{{ a.date_label }}</p>
      </div>
    </article>
    {{~/each}}
  </div>
</section>
{{/if}}

{{/block}}

{{/}}
