{{< layouts/main.dve}}
{{#block title}}{{ article.seo_title }} — {{ site.name }}{{/block}}
{{#block body}}

<article class="container article-col">
  <p class="kicker">{{ article.kicker }}</p>
  <h1 class="article-headline">{{ article.headline }}</h1>
  <p class="article-lead">{{ article.lead }}</p>
  <p class="meta-line article-meta">{{ article.date_label }} · Gapura Media · Sumber: {{ article.sources.length }} penerbit</p>

  <figure class="article-cover">
    <img src="{{ article.cover.src }}" alt="{{ article.cover.alt }}">
    {{#if article.cover.credit}}<figcaption>Gambar: {{ article.cover.credit }}</figcaption>{{/if}}
  </figure>

  {{#each article.sections as s~}}
  <section class="article-section">
    {{#if s.heading}}<h2>{{ s.heading }}</h2>{{/if}}
    {{#each s.paragraphs as p~}}
    <p>{{ p }}</p>
    {{~/each}}
  </section>
  {{~/each}}

  {{#if article.takeaways.length}}
  <aside class="takeaways">
    <h2>Poin Penting</h2>
    <ul>
      {{#each article.takeaways as t~}}
      <li>{{ t }}</li>
      {{~/each}}
    </ul>
  </aside>
  {{/if}}

  {{#if article.sources.length}}
  <aside class="sources">
    <h2>Sumber Berita</h2>
    <ul>
      {{#each article.sources as s~}}
      <li><a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.name }}</a></li>
      {{~/each}}
    </ul>
  </aside>
  {{/if}}

  <aside class="social-box">
    <h2>Berita ini juga terbit di</h2>
    <div class="follow-actions">
      {{#if article.social.instagram}}<a class="btn-solid" href="{{ article.social.instagram }}" target="_blank" rel="noopener">Instagram @gapuramedia</a>{{/if}}
      {{#if article.social.facebook}}<a class="btn-outline" href="{{ article.social.facebook }}" target="_blank" rel="noopener">Facebook Gapura Media</a>{{/if}}
    </div>
  </aside>
</article>

{{#if others.length}}
<section class="container article-more">
  <div class="more-related">
    <div class="section-head"><h2>Artikel Terkait</h2></div>
    <div class="related-grid">
      {{#each others as a~}}
      <article class="rel-card">
        <a class="rel-media" href="/artikel/{{ a.slug }}/">
          <img src="{{ a.cover.src }}" alt="{{ a.cover.alt }}" loading="lazy">
        </a>
        <p class="kicker">{{ a.kicker }}</p>
        <h3 class="rel-title"><a href="/artikel/{{ a.slug }}/">{{ a.headline }}</a></h3>
        <p class="meta-line">{{ a.date_label }}</p>
      </article>
      {{~/each}}
    </div>
  </div>
  <div class="more-mostread">
    <div class="section-head"><h2>Paling Banyak Dibaca</h2></div>
    <ol class="most-read">
      {{#each others as a~}}
      <li class="most-read-item">
        <span class="mr-num" aria-hidden="true">{{ @index + 1 }}</span>
        <div class="mr-body">
          <h3 class="mr-title"><a href="/artikel/{{ a.slug }}/">{{ a.headline }}</a></h3>
          <p class="meta-line">{{ a.desk }} · {{ a.date_label }}</p>
        </div>
      </li>
      {{~/each}}
    </ol>
  </div>
</section>
{{/if}}

{{/block}}

{{/}}
