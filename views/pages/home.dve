{{< layouts/main.dve}}
{{#block title}}{{ site.name }} — Berita Lengkap Politik, Ekonomi &amp; Bursa{{/block}}
{{#block body}}

<section class="hero container">
  <h1 class="statement">Berita lengkap, <span class="accent">terverifikasi</span>, tanpa potongan.</h1>
  <p class="statement-sub">{{ site.description }}</p>
  <div class="desk-row">
    {{#each site.desks as d~}}
    <span class="desk-chip">{{ d }}</span>
    {{~/each}}
  </div>

  {{#if featured}}
  <a class="hero-card" href="/artikel/{{ featured.slug }}/">
    <div class="hero-media">
      <img src="{{ featured.cover.src }}" alt="{{ featured.cover.alt }}" loading="eager">
    </div>
    <div class="hero-body">
      <span class="chip">{{ featured.desk }}</span>
      <h2 class="hero-headline">{{ featured.headline }}</h2>
      <p class="hero-lead">{{ featured.meta_description }}</p>
      <p class="meta-line">{{ featured.date_label }} · Gapura Media</p>
    </div>
  </a>
  {{/if}}
</section>

<section class="container section-block">
  <div class="section-head">
    <p class="section-kicker">Baru diterbitkan</p>
    <h2>Berita Terbaru</h2>
    <span class="section-rule" aria-hidden="true"></span>
  </div>
  <div class="grid">
    {{#each rest as a~}}
    <article class="card">
      <a class="card-media" href="/artikel/{{ a.slug }}/">
        <img src="{{ a.cover.src }}" alt="{{ a.cover.alt }}" loading="lazy">
      </a>
      <div class="card-body">
        <span class="chip">{{ a.desk }}</span>
        <h3 class="card-title"><a href="/artikel/{{ a.slug }}/">{{ a.headline }}</a></h3>
        <p class="card-desc">{{ a.meta_description }}</p>
        <p class="meta-line">{{ a.date_label }}</p>
      </div>
    </article>
    {{~/each}}
  </div>
</section>

<section class="container about-strip">
  <h2>Versi lengkap dari setiap berita</h2>
  <p>Setiap carousel yang terbit di Instagram dan Facebook <strong>@gapuramedia</strong> memiliki versi artikel utuh di sini — konteks penuh, data pendukung, dan sumber yang bisa kamu periksa sendiri.</p>
  <div class="about-actions">
    <a class="btn-dark" href="{{ socials.instagram }}" target="_blank" rel="noopener">Ikuti di Instagram</a>
    <a class="btn-ghost" href="{{ socials.facebook }}" target="_blank" rel="noopener">Ikuti di Facebook</a>
  </div>
</section>

{{/block}}

{{/}}
