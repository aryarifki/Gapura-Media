{{< layouts/main.dve}}
{{#block title}}{{ site.name }} — Berita Lengkap Politik, Ekonomi &amp; Bursa{{/block}}
{{#block body}}

{{#if featured}}
<section class="container top-story">
  <div class="top-story-text">
    <p class="kicker">{{ featured.kicker }}</p>
    <h1 class="top-headline"><a href="/artikel/{{ featured.slug }}/">{{ featured.headline }}</a></h1>
    <p class="top-lead">{{ featured.meta_description }}</p>
    <p class="meta-line">{{ featured.date_label }} · Gapura Media</p>
  </div>
  <a class="top-story-media" href="/artikel/{{ featured.slug }}/" aria-label="{{ featured.headline }}">
    <img src="{{ featured.cover.src }}" alt="{{ featured.cover.alt }}" loading="eager">
  </a>
</section>
{{/if}}

<div class="container front-grid">
  <section class="front-main" aria-label="Berita terbaru">
    <div class="section-head"><h2>Berita Terbaru</h2></div>
    <div class="story-list">
      {{#each rest as a~}}
      <article class="story-row">
        <a class="story-row-media" href="/artikel/{{ a.slug }}/">
          <img src="{{ a.cover.src }}" alt="{{ a.cover.alt }}" loading="lazy">
        </a>
        <div class="story-row-body">
          <p class="kicker">{{ a.kicker }}</p>
          <h3 class="story-row-title"><a href="/artikel/{{ a.slug }}/">{{ a.headline }}</a></h3>
          <p class="story-row-desc">{{ a.meta_description }}</p>
          <p class="meta-line">{{ a.date_label }}</p>
        </div>
      </article>
      {{~/each}}
    </div>
  </section>

  <aside class="front-rail" aria-label="Paling banyak dibaca">
    <div class="section-head"><h2>Paling Banyak Dibaca</h2></div>
    <ol class="most-read">
      {{#each articles as a~}}
      {{#if @index < 5}}
      <li class="most-read-item">
        <span class="mr-num" aria-hidden="true">{{ @index + 1 }}</span>
        <div class="mr-body">
          <h3 class="mr-title"><a href="/artikel/{{ a.slug }}/">{{ a.headline }}</a></h3>
          <p class="meta-line">{{ a.desk }} · {{ a.date_label }}</p>
        </div>
      </li>
      {{/if}}
      {{~/each}}
    </ol>
  </aside>
</div>

{{#each site.desks as d~}}
<section class="container desk-block" id="desk-{{ d }}">
  <div class="section-head"><h2>{{ d }}</h2></div>
  <div class="desk-list">
    {{#each articles as a~}}
    {{#if a.desk == d}}
    <article class="story-row">
      <a class="story-row-media" href="/artikel/{{ a.slug }}/">
        <img src="{{ a.cover.src }}" alt="{{ a.cover.alt }}" loading="lazy">
      </a>
      <div class="story-row-body">
        <p class="kicker">{{ a.kicker }}</p>
        <h3 class="story-row-title"><a href="/artikel/{{ a.slug }}/">{{ a.headline }}</a></h3>
        <p class="meta-line">{{ a.date_label }}</p>
      </div>
    </article>
    {{/if}}
    {{~/each}}
  </div>
</section>
{{~/each}}

<section class="container follow-band">
  <div class="follow-text">
    <h2>Versi lengkap dari setiap berita</h2>
    <p>Setiap carousel yang terbit di Instagram dan Facebook <strong>@gapuramedia</strong> memiliki versi artikel utuh di sini — konteks penuh, data pendukung, dan sumber yang bisa kamu periksa sendiri.</p>
  </div>
  <div class="follow-actions">
    <a class="btn-solid" href="{{ socials.instagram }}" target="_blank" rel="noopener">Ikuti di Instagram</a>
    <a class="btn-outline" href="{{ socials.facebook }}" target="_blank" rel="noopener">Ikuti di Facebook</a>
  </div>
</section>

{{/block}}

{{/}}
