<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="brand">
        <img class="brand-logo brand-logo-footer" src="/assets/logo-mark.svg?v=3" alt="" width="40" height="40">
        <span class="brand-name"><span class="bn-top">Gapura</span><span class="bn-bottom">Media</span></span>
      </span>
      <p class="footer-desc">{{ site.description }}</p>
    </div>
    <nav class="footer-links" aria-label="Tautan footer">
      <a href="{{ socials.instagram }}" target="_blank" rel="noopener">Instagram @gapuramedia</a>
      <a href="{{ socials.facebook }}" target="_blank" rel="noopener">Facebook Gapura Media</a>
      <a href="/feed.xml">RSS</a>
      <a href="/sitemap.xml">Sitemap</a>
      <a href="/privacy/">Kebijakan Privasi</a>
    </nav>
  </div>
  <div class="footer-bar">
    <div class="container footer-bar-inner">
      <span>GAPURAMEDIA.MY.ID</span>
      <span>© {{ site.year }} Gapura Media</span>
    </div>
  </div>
</footer>
