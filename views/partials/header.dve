<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Gapura Media — Beranda">
      <img class="brand-logo" src="/assets/logo-mark-light.svg?v=1" alt="" width="44" height="44">
      <span class="brand-name"><span class="bn-top">Gapura</span><span class="bn-bottom">Media</span></span>
    </a>
    <div class="header-utils">
      <a href="{{ socials.instagram }}" target="_blank" rel="noopener">Instagram</a>
      <a href="{{ socials.facebook }}" target="_blank" rel="noopener">Facebook</a>
    </div>
  </div>
  <nav class="desk-nav" aria-label="Navigasi desk">
    <div class="container desk-nav-inner">
      <a class="desk-link" href="/">Beranda</a>
      {{#each site.desks as d~}}
      <a class="desk-link" href="/#desk-{{ d }}">{{ d }}</a>
      {{~/each}}
    </div>
  </nav>
</header>
