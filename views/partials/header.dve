<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Gapura Media — Beranda">
      <span class="brand-bar" aria-hidden="true"></span>
      <span class="brand-text">GAPURA <span class="brand-media">MEDIA</span></span>
    </a>
    <nav class="main-nav" aria-label="Navigasi utama">
      <a href="/">Terbaru</a>
      <a href="{{ socials.instagram }}" target="_blank" rel="noopener">Instagram</a>
      <a href="{{ socials.facebook }}" target="_blank" rel="noopener">Facebook</a>
    </nav>
  </div>
  <div class="header-tagline">
    <div class="container">{{ site.tagline }}</div>
  </div>
</header>
